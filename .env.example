# =============================================================================
# SIO — Spatial Intelligence OS — configuration
# =============================================================================
# Copy to `.env` (`just setup` does this for you) and edit. Every value below is
# the default baked into `sio_core.config.Settings`, so an empty `.env` is valid.
#
# Naming: every variable is SIO_*, except third-party conventions (NEO4J_*, etc.).
# Adapter selectors are the "swappable seams" of the PRD §9.3 — see docs/GPU_SWAP.md.
# =============================================================================

# --- Identity & runtime ------------------------------------------------------
SIO_ENV=local                      # local | staging | prod  (affects log format + strictness)
SIO_TENANT_ID=default              # default tenant for locally produced data
SIO_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SIO_LOG_FORMAT=console             # console (dev, human) | json (prod, structured)
SIO_DATA_DIR=.sio                  # all local state: db data dirs, models, samples, logs

# --- Adapter selection (the seams) -------------------------------------------
SIO_BUS_BACKEND=redis              # redis | memory | kafka
SIO_GRAPH_BACKEND=neo4j            # neo4j | postgres | memory
SIO_VECTOR_BACKEND=pgvector        # pgvector | memory | qdrant
SIO_BLOB_BACKEND=minio             # minio | file
SIO_DETECTOR=auto                  # auto | onnx | onnx_seg | synthetic | null | deepstream
SIO_TRACKER=bytetrack              # bytetrack | geo | boxmot | deepstream
SIO_EMBEDDER=clip                  # clip | hash
SIO_FORECASTER=statsforecast       # statsforecast | naive | timesfm
SIO_LLM_PROVIDER=ollama            # ollama | openai_compat | scripted
SIO_AUTH_MODE=dev                  # dev | keycloak
SIO_POLICY_ENGINE=embedded         # embedded | opa | openfga
SIO_WORKFLOW_RUNNER=temporal       # temporal | inline
SIO_CEP_RUNTIME=native             # native | bytewax

# --- Postgres (+ PostGIS + pgvector) ----------------------------------------
SIO_PG_HOST=127.0.0.1
SIO_PG_PORT=5432
SIO_PG_DATABASE=sio
SIO_PG_USER=sio
SIO_PG_PASSWORD=sio
SIO_PG_POOL_MIN=1
SIO_PG_POOL_MAX=8

# --- Redis (event bus + cache + timeline tail) ------------------------------
SIO_REDIS_URL=redis://127.0.0.1:6379/0
SIO_BUS_MAXLEN=100000              # approximate per-stream trim length (XADD MAXLEN ~)
SIO_BUS_BLOCK_MS=2000              # XREADGROUP block timeout
SIO_BUS_BATCH=64                   # max messages per read
SIO_BUS_CLAIM_IDLE_MS=60000        # XAUTOCLAIM idle threshold for stuck messages
SIO_BUS_MAX_RETRIES=5              # deliveries before a message goes to the dead-letter stream

# --- Neo4j (world model graph) ----------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=siolocalpassword    # >= 8 chars; `just neo4j-init` sets this on first run
NEO4J_DATABASE=neo4j

# --- MinIO (raw media / object store) ---------------------------------------
SIO_MINIO_ENDPOINT=127.0.0.1:9000
SIO_MINIO_ACCESS_KEY=sioadmin
SIO_MINIO_SECRET_KEY=sioadminsecret
SIO_MINIO_BUCKET=sio-media
SIO_MINIO_SECURE=false

# --- Service ports (health + metrics on every service) ----------------------
SIO_API_PORT=8000
SIO_INGEST_PORT=8101
SIO_PERCEPTION_PORT=8102
SIO_TRACKING_PORT=8103
SIO_FUSION_PORT=8104
SIO_WORLDMODEL_PORT=8105
SIO_SPATIAL_PORT=8106
SIO_EVENTS_PORT=8107
SIO_PREDICTION_PORT=8108
SIO_SIMULATION_PORT=8109
SIO_DECISION_PORT=8110
SIO_COPILOT_PORT=8111
SIO_MCP_PORT=8112
SIO_AGENTS_PORT=8113
SIO_WORKFLOW_PORT=8114
SIO_ALERTS_PORT=8115
SIO_MISSIONS_PORT=8116
SIO_ANALYTICS_PORT=8117
SIO_GOVERNANCE_PORT=8118

# --- Web / API ---------------------------------------------------------------
SIO_API_BASE_URL=http://127.0.0.1:8000
SIO_WEB_PORT=5173
SIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ingest simulator (M1) ---------------------------------------------------
SIO_SIM_RATE=20                    # target events/second across all modalities
SIO_SIM_TRUCKS=6
SIO_SIM_FORKLIFTS=3
SIO_SIM_PEOPLE=8
SIO_SIM_DRONES=1
SIO_SIM_SEED=1337                  # deterministic scenarios (demo + tests depend on this)
SIO_SIM_SITE=infra/site/yard.geojson
SIO_SIM_FRAME_FPS=2                # frames/second published per camera
SIO_SIM_PUBLISH_ENTITIES=true      # Phase 1 bridge: simulator publishes ground-truth entities
SIO_SIM_ENTITY_HZ=2                # ground-truth entity publish rate
SIO_SIM_GPS_HZ=1                   # per-tracker GPS reporting rate
SIO_SIM_SENSOR_HZ=0.2              # per-sensor IoT reporting rate (every 5s)
SIO_SIM_TICK_HZ=4                  # simulation steps/second (motion smoothness, not publish rate)

# --- Perception (M3) ---------------------------------------------------------
SIO_MODEL_DIR=.sio/models
SIO_DET_MODEL=yolo26n.onnx
SIO_SEG_MODEL=yolo26n-seg.onnx
SIO_REID_MODEL=yolo26n-reid.onnx
SIO_CLIP_VISION_MODEL=clip-vision.onnx
SIO_CLIP_TEXT_MODEL=clip-text.onnx
SIO_CLIP_TOKENIZER=clip-tokenizer.json
SIO_DET_CONF=0.35                  # detection confidence floor
SIO_DET_IMGSZ=640
SIO_ORT_THREADS=2                  # onnxruntime intra-op threads per service process
SIO_ORT_PROVIDERS=CPUExecutionProvider   # CUDAExecutionProvider / TensorrtExecutionProvider for GPU
SIO_PERCEPTION_FPS=2               # frames/second actually inferred (sampling)
SIO_PERCEPTION_MAX_AGE_S=60        # skip frames older than this (stale backlog after a restart)
SIO_FRAME_INDEX_HZ=0.5             # per-camera rate for embedding frames into the search index
SIO_ENABLE_SEGMENTATION=false      # yolo26n-seg.onnx; CPU cost ~2x detection
SIO_ENABLE_OCR=true                # RapidOCR plate / container-ID reading
SIO_ENABLE_AUDIO=false             # ONNX AST AudioSet sound-event detection
SIO_ENABLE_SAM=false               # SAM 3.1 promptable segmentation (GPU phase)

# --- Governance: privacy & safety flags (PRD NG2 / R4) -----------------------
SIO_ENABLE_FACE_RECOGNITION=false  # HARD OFF by default. Legal review required to enable.
SIO_BLUR_FACES=true                # blur person-head regions before media is stored
SIO_BLUR_PLATES=true               # blur OCR-detected plate regions before media is stored
SIO_REDACT_PII=true                # Presidio redaction on text fields leaving the system
SIO_RETAIN_RAW=false               # keep un-blurred originals (policy-gated, audited)
SIO_AUDIT_ENABLED=true

# --- Tracking (M4) -----------------------------------------------------------
SIO_TRACK_MAX_AGE=30               # frames a lost track survives before removal
SIO_TRACK_MIN_HITS=3               # hits before a track is confirmed
SIO_TRACK_IOU_THRESHOLD=0.3
SIO_TRACK_REID_THRESHOLD=0.75      # cosine similarity for ReID re-association
SIO_ENABLE_CROSS_CAMERA=true

# --- Fusion (M5) -------------------------------------------------------------
SIO_FUSION_ASSOC_RADIUS_M=25       # spatial gate for observation→entity association
SIO_FUSION_TIME_WINDOW_S=5         # temporal gate
SIO_FUSION_MAX_STALE_S=120         # entity considered gone after this without observations

# --- Events & anomaly (M9) ---------------------------------------------------
SIO_RULES_DIR=infra/rules
SIO_DWELL_THRESHOLD_S=900          # UC1: "stayed more than 15 minutes"
SIO_SPEED_LIMIT_KMH=20             # yard speed limit for the speeding rule
SIO_ANOMALY_CONTAMINATION=0.02
SIO_ANOMALY_WARMUP=20              # samples before the detector scores; features are sampled
                                   # every 30 s, so 200 meant 100 minutes of silence

# --- Prediction (M10) --------------------------------------------------------
SIO_FORECAST_HORIZON_S=1800
SIO_FORECAST_INTERVAL_S=60

# --- Alerts (M16) ------------------------------------------------------------
SIO_ALERT_DEDUP_WINDOW_S=120
SIO_ALERT_ESCALATE_AFTER_S=300     # unacknowledged critical → escalate
# Optional outbound webhook. Keep the comment on its own line: python-dotenv reads a trailing
# `# comment` after an EMPTY value as the value itself, which is how this setting once became the
# literal string "# optional outbound webhook" and produced a failed POST per alert.
SIO_ALERT_WEBHOOK_URL=

# --- LLM / copilot (M13) -----------------------------------------------------
SIO_OLLAMA_URL=http://127.0.0.1:11434
# Pinned exact tag — never `:latest`. Chosen by scripts/eval_tool_calling.py (see docs/MODELS.md).
SIO_LLM_MODEL=llama3.2:3b       # measured winner: 95% tool selection, 81% arguments, p95 5.7s.
                                 # Restraint (67%) is handled in code, not by the model.
                                 # See docs/MODELS.md. An EXACT tag, never :latest.
SIO_LLM_TEMPERATURE=0.1
SIO_LLM_TIMEOUT_S=60
SIO_LLM_MAX_TOOL_STEPS=6
# For SIO_LLM_PROVIDER=openai_compat (vLLM / NIM / Nemotron). Comment on its own line — see above.
SIO_OPENAI_BASE_URL=
SIO_OPENAI_API_KEY=
SIO_COPILOT_ALLOW_DEGRADED=true    # fall back to the keyword router when tool-calling fails

# --- Workflow (M15) ----------------------------------------------------------
SIO_TEMPORAL_HOST=127.0.0.1:7233
SIO_TEMPORAL_NAMESPACE=default
SIO_TEMPORAL_TASK_QUEUE=sio-playbooks

# --- Agents (M14) ------------------------------------------------------------
SIO_AGENTS_ENABLED=security,logistics
SIO_AGENT_INTERVAL_S=30
SIO_AGENT_REQUIRE_APPROVAL=true    # human-on-the-loop. Do not disable in MVP.

# --- AuthN / AuthZ (M21) -----------------------------------------------------
SIO_JWT_SECRET=dev-only-change-me  # HS256 secret for SIO_AUTH_MODE=dev
SIO_JWT_ISSUER=sio-dev
SIO_JWT_TTL_S=86400
SIO_KEYCLOAK_URL=http://127.0.0.1:8080
SIO_KEYCLOAK_REALM=sio
SIO_KEYCLOAK_CLIENT_ID=sio-api
SIO_OPA_URL=http://127.0.0.1:8181
SIO_OPENFGA_URL=http://127.0.0.1:8080
SIO_OPENFGA_STORE_ID=

# --- Observability -----------------------------------------------------------
SIO_METRICS_ENABLED=true
SIO_GRAFANA_PORT=3000

# --- Retention (NFR §13) -----------------------------------------------------
SIO_RETAIN_FRAMES_DAYS=7
SIO_RETAIN_OBSERVATIONS_DAYS=30
SIO_RETAIN_EVENTS_DAYS=365         # events + audit are immutable; retention only tiers them
SIO_RETAIN_AUDIT_DAYS=3650

# --- Testing -----------------------------------------------------------------
SIO_TEST_INFRA=0                   # 1 → run @pytest.mark.infra tests against live services
