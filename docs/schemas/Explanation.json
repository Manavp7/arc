{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "description": "A hypothesis SIO considered and did not choose.\n\nSurfacing these is what separates \"the system says X\" from \"the system considered Y and\nZ and here is why it preferred X\".",
      "properties": {
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "why_not": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Not"
        }
      },
      "required": [
        "hypothesis"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "What a piece of evidence in an explanation points at.",
      "enum": [
        "frame",
        "observation",
        "detection",
        "track",
        "entity",
        "event",
        "forecast",
        "decision",
        "query",
        "document",
        "simulation",
        "rule",
        "model"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A pointer to something a human can go and check.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "ref": {
          "description": "Id, object-store key, or the query text for kind=query",
          "title": "Ref",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relevance/similarity, if ranked",
          "title": "Score"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "description": "One beat in the story an explanation tells.",
      "properties": {
        "kind": {
          "description": "observation | detection | event | decision | action | note",
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "kind",
        "summary"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "$id": "https://sio.dev/schemas/1.0.0/Explanation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The standard evidence bundle attached to every assertion (PRD M20, \u00a78.1).",
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "confidence": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "degraded": {
      "default": false,
      "description": "True when a fallback path produced this answer (e.g. LLM tool-calling failed)",
      "title": "Degraded",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "related_entities": {
      "items": {
        "type": "string"
      },
      "title": "Related Entities",
      "type": "array"
    },
    "sources": {
      "description": "Contributing sensors/systems",
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "title": "Timeline",
      "type": "array"
    }
  },
  "title": "Explanation",
  "type": "object",
  "x-sio-schema-version": "1.0.0"
}
