# Pinned dependency versions (PRD risk R5: "Homebrew drift/version breaks").
#
# Anything installed by scripts/bootstrap.sh is pinned here so a fresh machine gets the same
# stack six months from now. Update deliberately, in one place, and re-run `just doctor`.

# --- language runtimes -------------------------------------------------------
SIO_PYTHON_VERSION=3.12
SIO_NODE_MAJOR=22

# --- datastores --------------------------------------------------------------
# macOS: Homebrew formula names (versioned where the formula supports it).
SIO_BREW_POSTGRES=postgresql@16
SIO_BREW_POSTGIS=postgis
SIO_BREW_PGVECTOR=pgvector
SIO_BREW_REDIS=redis
SIO_BREW_NEO4J=neo4j
SIO_BREW_MINIO=minio
SIO_BREW_OLLAMA=ollama
SIO_BREW_TEMPORAL=temporal
SIO_BREW_GRAFANA=grafana
SIO_BREW_GSTREAMER=gstreamer

# Linux: apt package names (postgres/redis) and tarball versions (everything else),
# because apt's neo4j/minio packages assume systemd and system-wide ownership, while SIO
# keeps all state user-owned under .sio/ so `just clean` is complete and reversible.
SIO_APT_POSTGRES=postgresql-16
SIO_APT_POSTGIS=postgresql-16-postgis-3
SIO_APT_PGVECTOR=postgresql-16-pgvector
SIO_APT_REDIS=redis-server

SIO_NEO4J_VERSION=5.26.0
SIO_NEO4J_TARBALL_URL="https://dist.neo4j.org/neo4j-community-${SIO_NEO4J_VERSION}-unix.tar.gz"

# MinIO and the Temporal CLI publish rolling release channels; pin by date-stamped tag.
SIO_MINIO_URL_LINUX="https://dl.min.io/server/minio/release/linux-amd64/minio"
SIO_MINIO_URL_DARWIN="https://dl.min.io/server/minio/release/darwin-arm64/minio"
SIO_TEMPORAL_VERSION=1.1.2

# --- models (fetched by `just models`, checksummed in infra/models.json) ------
SIO_MODEL_RELEASE=v8.4.0
SIO_MODEL_BASE_URL="https://github.com/ultralytics/assets/releases/download/${SIO_MODEL_RELEASE}"
SIO_CLIP_REPO=Xenova/clip-vit-base-patch32
SIO_CLIP_REVISION=main

# --- local LLM ---------------------------------------------------------------
# Exact tag, never `:latest`. Selected by scripts/eval_tool_calling.py; see docs/MODELS.md.
SIO_LLM_MODEL_DEFAULT=qwen3:1.7b
