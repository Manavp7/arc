package sio.authz

import rego.v1

default allow := false

# An authenticated principal is one with a tenant.
authenticated if input.principal.tenant != ""

# Admin bypass, except where a rule demands the pii_scope claim.
#
# tenant_matches is asserted HERE, not only in the per-rule blocks below. Omitting it let an
# admin read another tenant's data — which is exactly what the Python engine did on its first
# run, before the check was moved above the bypass. An admin is an admin OF A TENANT; there is
# deliberately no cross-tenant role in this model.
allow if {
	authenticated
	"admin" in input.principal.roles
	not pii_rule_applies
	known_action
	tenant_matches
}

# An action the policy defines. The admin bypass applies only to these.
known_action if startswith(input.action, "admin.")
known_action if input.action == "policy.write"
known_action if input.action == "tenant.create"
known_action if input.action == "decision.approve"
known_action if input.action == "decision.reject"
known_action if input.action == "workflow.execute"
known_action if input.action == "simulation.inject"
known_action if input.action == "pii.view"
known_action if input.action == "media.raw"
known_action if input.action == "alerts.write"
known_action if input.action == "entities.read"
known_action if input.action == "events.read"
known_action if input.action == "alerts.read"
known_action if input.action == "copilot.ask"
known_action if input.action == "integration.write"
known_action if input.action == "model.write"
known_action if endswith(input.action, ".read")

pii_rule_applies if {
	input.action in ["pii.view", "media.raw"]
}

# Administrative surfaces are admin-only
allow if {
	authenticated
	startswith(input.action, "admin.")
	some role in ["admin"]
	role in input.principal.roles
	tenant_matches
}

# Editing policy needs admin and high clearance: it is the lock on every other door
allow if {
	authenticated
	input.action == "policy.write"
	not startswith(input.action, "admin.")
	some role in ["admin"]
	role in input.principal.roles
	input.principal.clearance >= 3
	tenant_matches
}

# Creating tenants is administrative
allow if {
	authenticated
	input.action == "tenant.create"
	not startswith(input.action, "admin.")
	input.action != "policy.write"
	some role in ["admin"]
	role in input.principal.roles
	tenant_matches
}

# Authorising an action in the physical world is a commander's decision
allow if {
	authenticated
	input.action == "decision.approve"
	not startswith(input.action, "admin.")
	input.action != "policy.write"
	input.action != "tenant.create"
	some role in ["commander", "admin"]
	role in input.principal.roles
	input.principal.clearance >= 2
	tenant_matches
}

# Rejecting is safe: it results in nothing happening
allow if {
	authenticated
	input.action == "decision.reject"
	not startswith(input.action, "admin.")
	input.action != "policy.write"
	input.action != "tenant.create"
	input.action != "decision.approve"
	some role in ["operator", "commander", "admin"]
	role in input.principal.roles
	tenant_matches
}

# Running a playbook can dispatch responders
allow if {
	authenticated
	input.action == "workflow.execute"
	not startswith(input.action, "admin.")
	input.action != "policy.write"
	input.action != "tenant.create"
	input.action != "decision.approve"
	input.action != "decision.reject"
	some role in ["commander", "admin"]
	role in input.principal.roles
	input.principal.clearance >= 2
	tenant_matches
}

# Injecting a simulated incident affects no physical thing
allow if {
	authenticated
	input.action == "simulation.inject"
	not startswith(input.action, "admin.")
	input.action != "policy.write"
	input.action != "tenant.create"
	input.action != "decision.approve"
	input.action != "decision.reject"
	input.action != "workflow.execute"
	some role in ["operator", "commander", "admin", "ml_engineer"]
	role in input.principal.roles
