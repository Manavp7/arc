{
  "realm": "sio",
  "enabled": true,
  "displayName": "Spatial Intelligence OS",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access"
      },
      {
        "name": "operator",
        "description": "Triage the inbox, acknowledge alerts, reject recommendations"
      },
      {
        "name": "commander",
        "description": "Authorise action in the physical world: approve decisions, run playbooks"
      },
      {
        "name": "integrator",
        "description": "Register connectors and webhooks"
      },
      {
        "name": "ml_engineer",
        "description": "Change models and thresholds"
      },
      {
        "name": "admin",
        "description": "Administrative surfaces, within one tenant"
      },
      {
        "name": "service",
        "description": "Machine principal; the actions a service's job needs and no more"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sio-api",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-in-any-real-deployment",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "access.token.lifespan": "1800"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "clearance",
            "claim.name": "clearance",
            "jsonType.label": "int",
            "access.token.claim": "true"
          }
        },
        {
          "name": "pii_scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "pii_scope",
            "claim.name": "pii_scope",
            "jsonType.label": "boolean",
            "access.token.claim": "true"
          }
        },
        {
          "name": "zones",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "zones",
            "claim.name": "zones",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sio-console",
      "name": "SIO browser console",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "consentRequired": false,
      "redirectUris": [
        "http://localhost:5173/",
        "http://127.0.0.1:5173/"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "access.token.lifespan": "1800"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "clearance",
            "claim.name": "clearance",
            "jsonType.label": "int",
            "access.token.claim": "true"
          }
        },
        {
          "name": "pii_scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "pii_scope",
            "claim.name": "pii_scope",
            "jsonType.label": "boolean",
            "access.token.claim": "true"
          }
        },
        {
          "name": "zones",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "zones",
            "claim.name": "zones",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sio-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sio-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "sio-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "email": "operator@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ],
      "attributes": {
        "tenant": [
          "default"
        ],
        "clearance": [
          "1"
        ],
        "pii_scope": [
          "false"
        ]
      }
    },
    {
      "username": "commander",
      "enabled": true,
      "email": "commander@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "commander",
          "temporary": false
        }
      ],
      "realmRoles": [
        "commander",
        "operator"
      ],
      "attributes": {
        "tenant": [
          "default"
        ],
        "clearance": [
          "2"
        ],
        "pii_scope": [
          "true"
        ]
      }
    },
    {
      "username": "zoned",
      "enabled": true,
      "email": "zoned@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "zoned",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ],
      "attributes": {
        "tenant": [
          "default"
        ],
        "clearance": [
          "1"
        ],
        "pii_scope": [
          "false"
        ],
        "zones": [
          "dock_1",
          "dock_2"
        ]
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "sio-console",
      "roles": [
        "viewer",
        "operator",
        "commander",
        "integrator",
        "ml_engineer",
        "admin"
      ]
    }
  ]
}
