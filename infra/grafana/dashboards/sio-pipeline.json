{
  "__inputs": [],
  "uid": "sio-pipeline",
  "title": "SIO \u2014 pipeline",
  "description": "Throughput, lag and latency across the SIO pipeline. Generated by scripts in the repo rather than clicked together, so a change is a reviewable diff.",
  "tags": [
    "sio",
    "pipeline"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "DS_SIO_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "SIO Prometheus",
          "value": "SIO Prometheus"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Bus throughput \u2014 messages published per second",
      "description": "Per topic. A topic that flatlines while others move is a stalled producer.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sio_messages_produced_total[1m])) by (topic)",
          "legendFormat": "{{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Consumer lag \u2014 messages behind",
      "description": "The single most useful number for diagnosing a slow pipeline: a rising lag means a consumer cannot keep up, and it rises long before anything errors.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sio_consumer_lag) by (service, topic)",
          "legendFormat": "{{service}} / {{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Dead-lettered messages",
      "description": "Should be flat at zero. The DLQ is containment, and containment without visibility hid every track failing to persist for an entire phase \u2014 23,000 messages while health said ok.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(sio_dead_lettered_total[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Inference rate and latency",
      "description": "Inferences per second and their p95 latency, from sio_inference_seconds. The first version of this panel plotted sio_frames_inferred_total and sio_frames_seen_total, neither of which exists \u2014 a plausible name is not a real one, and six of these seven panels would have been empty.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sio_inference_seconds_count[1m])) by (model)",
          "legendFormat": "{{model}} /s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sio_inference_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}} p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Event rate",
      "description": "Events published per second, from the produced counter filtered to the events topic. There is no per-severity metric \u2014 severity lives in the payload, not in a label \u2014 so this panel reads the topic rather than inventing a dimension the platform does not export.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sio_messages_produced_total{topic=\"events\"}[5m]))",
          "legendFormat": "events/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        },
        {
          "expr": "sum(rate(sio_messages_produced_total{topic=\"alerts\"}[5m]))",
          "legendFormat": "alerts/s",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "API latency",
      "description": "p50 and p95, never a mean: request latency has a long right tail and a mean sits above most requests while hiding the slow ones.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sio_http_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sio_http_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Service health",
      "description": "One tile per process. A missing series is a service that is not running, which is different from one reporting zero.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_SIO_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sio_up",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_SIO_PROMETHEUS}"
          }
        }
      ]
    }
  ]
}
